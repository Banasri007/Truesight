# Copy to .env and fill in what you need. Every value has a working default for
# local development (simulator + mock vision + local signing key).

# ---- Server -------------------------------------------------------------------------
PORT=8787
# Public HTTPS URL of this server (used for Ring webhooks and OAuth redirects).
# Defaults to http://localhost:${PORT}
PUBLIC_BASE_URL=
DATA_DIR=data
# Set this before exposing the server to the internet. The dashboard asks for it once.
ADMIN_TOKEN=

# ---- Ring -----------------------------------------------------------------------------
# simulator = no Ring account needed; api = real Ring Partner API
RING_MODE=simulator
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# HMAC key from the Ring Developer Console: verifies webhooks and one-way link nonces.
RING_HMAC_KEY=
# Shortcuts that skip AppStore account linking (pick at most one):
# - RING_ACCESS_TOKEN: ~30-minute token from https://developer.amazon.com/ring/console/playground
#   (enough on its own: no client id/secret needed, but no webhooks; sensors run on schedule / "Check now")
# - RING_REFRESH_TOKEN: refresh token from a completed link (needs RING_CLIENT_ID / RING_CLIENT_SECRET)
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
# Same hosts for staging and production; staging is selected in the Developer Console.
RING_API_BASE=https://api.amazonvision.com
RING_OAUTH_BASE=https://oauth.ring.com
RING_SCOPE=ava.v1:read
# Defaults to ${PUBLIC_BASE_URL}/auth/ring/callback
RING_REDIRECT_URI=

# ---- Perception (vision AI) ------------------------------------------------------------
# mock = offline, uses simulator ground truth; groq = Groq; anthropic = Claude API; bedrock = Claude in Amazon Bedrock
VISION_PROVIDER=mock
# For VISION_PROVIDER=groq (key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# For VISION_PROVIDER=anthropic (the SDK reads ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# For VISION_PROVIDER=bedrock (uses your normal AWS credentials chain)
BEDROCK_MODEL=anthropic.claude-opus-5-5
VISION_EFFORT=low
AWS_REGION=us-east-1
# none = rely on privacy zones; rekognition = Amazon Rekognition DetectFaces (locations only, never identity)
FACE_DETECTOR=none

# ---- Proof -----------------------------------------------------------------------------
# local = EC P-256 key in DATA_DIR/keys; kms = AWS KMS asymmetric key (ECC_NIST_P256, SIGN_VERIFY)
SIGNER=local
KMS_KEY_ID=
# local = DATA_DIR/ledger.jsonl; dynamodb = table with pk (S) + seq (N)
LEDGER_STORE=local
DYNAMODB_LEDGER_TABLE=
# local = DATA_DIR/blobs; s3 = bucket (enable Object Lock on the bucket for WORM originals)
BLOB_STORE=local
S3_EVIDENCE_BUCKET=
S3_OBJECT_LOCK_MODE=off
EVIDENCE_RETENTION_DAYS=30

# ---- Actions ---------------------------------------------------------------------------
# Optional Amazon SNS topic for alert SMS / email
SNS_TOPIC_ARN=
